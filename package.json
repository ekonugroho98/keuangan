{
  "name": "karaya-keuangan",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:web": "pnpm --filter @karaya/web dev",
    "dev:api": "pnpm --filter @karaya/api dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run --passWithNoTests",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "gen:api-client": "bash scripts/gen-api-client.sh",
    "gen:tools": "tsx scripts/gen-tools.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "tesseract.js"
    ]
  }
}
