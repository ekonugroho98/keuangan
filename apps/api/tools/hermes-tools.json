        },
        "amount_text": {
          "type": "string",
          "description": "Nominal yang diterima"
        },
        "account": {
          "type": "string",
          "description": "Nama akun atau UUID tujuan dana"
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD; default hari ini",
          "format": "date"
        }
      },
      "required": [
        "piutang_id",
        "amount_text",
        "account"
      ]
    },
    "endpoint": {
      "method": "POST",
      "path": "/v1/piutang/{piutang_id}/receipts"
    },
    "scope": "write",
    "idempotent": true
  },
  {
