# ─────────────────────────────────────────────────────────────
# Karaya Finance — apps/api environment variables
# Salin jadi .env.local lalu isi: cp .env.example .env.local
# Fase 1: hanya bagian "Dipakai sekarang" yang wajib agar `pnpm dev` jalan.
# ─────────────────────────────────────────────────────────────

# --- Dipakai sekarang (Fase 1) ---
API_PUBLIC_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173
PORT=8787
LOG_LEVEL=info

# --- Ditambahkan Fase 3 (DB & auth JWT) ---
# DATABASE_URL=postgres://karaya_api:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Ditambahkan Fase 6 (api key, idempotency, rate limit) ---
# API_KEY_PEPPER=
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_DAY=2000
# IDEMPOTENCY_TTL_HOURS=24
