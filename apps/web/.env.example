# ─────────────────────────────────────────────────────────────
# Karaya Finance — apps/web environment variables
# Salin jadi .env lalu isi: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Supabase — hanya dipakai untuk login/session/refresh (Fase 4+: data lewat apps/api)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# apps/api (backend Hono). Lokal: http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787

# karaya-api (harga emas & saham live, repo terpisah). Default sudah benar, override hanya kalau perlu.
VITE_PRICES_API_BASE_URL=https://karaya-api-jec2.vercel.app

# Branding (opsional)
VITE_APP_NAME=Karaya
VITE_APP_TAGLINE=Wealth Ledger
